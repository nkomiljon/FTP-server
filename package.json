{
  "name": "ftp-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:ftps": "node src/ftps-server.js",
    "genkey": "ssh-keygen -t rsa -b 4096 -f host.key -N \"\"",
    "gencert": "openssl req -x509 -newkey rsa:4096 -keyout ftps-key.pem -out ftps-cert.pem -days 365 -nodes -subj \"/CN=localhost\""
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "ftp-srv": "^4.6.3",
    "ssh2": "^1.15.0"
  }
}
